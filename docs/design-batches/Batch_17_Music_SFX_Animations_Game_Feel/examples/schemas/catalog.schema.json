{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixipelago.invalid/schemas/b17.catalog.draft.schema.json",
  "title": "Mixipelago Batch 17 draft catalog schema",
  "type": "object",
  "required": [
    "batch",
    "catalogVersion",
    "status",
    "productionReady",
    "gateEnabled",
    "cues"
  ],
  "properties": {
    "batch": {
      "const": 17
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 4
    },
    "status": {
      "const": "draft"
    },
    "productionReady": {
      "const": false
    },
    "gateEnabled": {
      "const": false
    },
    "cues": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "event",
          "bus",
          "maxVoices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "bus": {
            "type": "string"
          },
          "maxVoices": {
            "type": "integer"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
