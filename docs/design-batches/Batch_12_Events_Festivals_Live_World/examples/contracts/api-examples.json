{
  "batch": 12,
  "designOnly": true,
  "status": "not_deployed",
  "auth": "Server derives actor from verified auth session. Never trust playerId from client body.",
  "idempotency": "Idempotency-Key required on mutations that can create state/rewards; same key+body returns prior receipt, different body conflicts.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/events",
      "illustrativeResponse": "{editions,serverTime}"
    },
    {
      "method": "GET",
      "path": "/v1/events/{editionId}",
      "illustrativeResponse": "{edition,activities,participation}"
    },
    {
      "method": "POST",
      "path": "/v1/events/{editionId}/enroll",
      "illustrativeResponse": "{} → enrollmentId"
    },
    {
      "method": "POST",
      "path": "/v1/events/{editionId}/activities/{activityId}/claim",
      "illustrativeResponse": "{evidenceId} → receiptId"
    }
  ],
  "events": [
    {
      "name": "event.edition_activated.v1",
      "envelope": {
        "eventId": "UUID",
        "schemaVersion": 1,
        "sourceId": "stable-unique-source",
        "catalogHash": "sha256:...",
        "occurredAt": "ISO-8601 UTC"
      }
    },
    {
      "name": "event.contribution_verified.v1",
      "envelope": {
        "eventId": "UUID",
        "schemaVersion": 1,
        "sourceId": "stable-unique-source",
        "catalogHash": "sha256:...",
        "occurredAt": "ISO-8601 UTC"
      }
    },
    {
      "name": "event.reward_claimed.v1",
      "envelope": {
        "eventId": "UUID",
        "schemaVersion": 1,
        "sourceId": "stable-unique-source",
        "catalogHash": "sha256:...",
        "occurredAt": "ISO-8601 UTC"
      }
    },
    {
      "name": "event.edition_archived.v1",
      "envelope": {
        "eventId": "UUID",
        "schemaVersion": 1,
        "sourceId": "stable-unique-source",
        "catalogHash": "sha256:...",
        "occurredAt": "ISO-8601 UTC"
      }
    }
  ],
  "errorCodes": [
    "UNAUTHENTICATED",
    "FORBIDDEN",
    "FEATURE_DISABLED",
    "CATALOG_STALE",
    "REVISION_CONFLICT",
    "IDEMPOTENCY_CONFLICT",
    "SOURCE_UNVERIFIED",
    "RATE_LIMITED",
    "SERVICE_UNAVAILABLE"
  ]
}
