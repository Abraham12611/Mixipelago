{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixipelago.example/schemas/mission.schema.json",
  "title": "Mixipelago mission definition: schema v1 and proposed v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "missionId",
    "islandId",
    "missionVersion",
    "mode",
    "board",
    "spawn",
    "rewards",
    "visualThemeId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "missionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$",
      "maxLength": 90
    },
    "islandId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "missionVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mode": {
      "enum": [
        "service",
        "precision",
        "score_attack",
        "rush_hour",
        "survival",
        "vip_service",
        "endless",
        "festival",
        "ghost_challenge",
        "ranked_duel"
      ]
    },
    "releaseStatus": {
      "enum": [
        "planned",
        "internal",
        "beta",
        "live",
        "retired"
      ]
    },
    "featureFlag": {
      "type": "string",
      "minLength": 1
    },
    "modeRulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "object",
      "required": [
        "presetId",
        "width",
        "height",
        "dangerLineY",
        "maxActiveDrinks",
        "startingDrinks"
      ],
      "properties": {
        "presetId": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "dangerLineY": {
          "type": "number",
          "minimum": 0
        },
        "maxActiveDrinks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "startingDrinks": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "required": [
              "tier",
              "x",
              "y"
            ],
            "properties": {
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "spawn": {
      "type": "object",
      "required": [
        "seedMode",
        "pool",
        "firstItems"
      ],
      "properties": {
        "seedMode": {
          "enum": [
            "per-run",
            "fixed"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "pool": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tier",
              "weight"
            ],
            "properties": {
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "firstItems": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      },
      "additionalProperties": true
    },
    "orders": {
      "type": "object",
      "required": [
        "maxVisible",
        "initial"
      ],
      "properties": {
        "maxVisible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "initial": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "requestedTier",
              "quantity",
              "coinReward"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requestedTier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "coinReward": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            },
            "additionalProperties": true
          }
        },
        "replacementPoolId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "goal": {
      "type": "object",
      "required": [
        "type",
        "count"
      ],
      "properties": {
        "type": {
          "enum": [
            "orders_served",
            "merge_count",
            "score_at_least",
            "produce_tier"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "additionalProperties": true
    },
    "objectives": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/objective"
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          }
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "shotsMax": {
          "type": "integer",
          "minimum": 1
        },
        "settleMaxTicks": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "active_ticks"
        },
        "limitTicks": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "limitTicks"
      ],
      "additionalProperties": false
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "arrivals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "arrivals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tick",
                "tier",
                "x",
                "y"
              ],
              "properties": {
                "tick": {
                  "type": "integer",
                  "minimum": 0
                },
                "tier": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "starCriteria": {
      "type": "object",
      "properties": {
        "two": {
          "$ref": "#/$defs/star"
        },
        "three": {
          "$ref": "#/$defs/star"
        }
      },
      "additionalProperties": false
    },
    "rewards": {
      "type": "object",
      "required": [
        "previewCoins",
        "stars"
      ],
      "properties": {
        "previewCoins": {
          "type": "integer",
          "minimum": 0
        },
        "stars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": true
    },
    "visualThemeId": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "enum": [
                "orders_served",
                "merge_count",
                "score_at_least",
                "combo_depth",
                "survive_waves"
              ]
            },
            "target": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "tier",
            "target"
          ],
          "properties": {
            "type": {
              "const": "produce_tier"
            },
            "tier": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "target": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "enum": [
                "allOf",
                "anyOf",
                "sequence"
              ]
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/objective"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "star": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "shots_at_most",
            "score_at_least",
            "active_ticks_at_most"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "goal",
          "orders"
        ],
        "properties": {
          "mode": {
            "const": "service"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "objectives",
          "modeRulesVersion",
          "releaseStatus"
        ]
      }
    }
  ]
}
