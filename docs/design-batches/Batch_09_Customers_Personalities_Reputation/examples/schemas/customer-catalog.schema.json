{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixipelago.example/schemas/customer-catalog.schema.json",
  "title": "Mixipelago Batch 9 Draft Customer Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "releaseState",
    "segments",
    "customers",
    "pools",
    "policies",
    "flagsDefault",
    "alphaFixture"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "minLength": 3
    },
    "releaseState": {
      "const": "draft"
    },
    "segments": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "segmentId",
          "displayName",
          "releaseState"
        ],
        "additionalProperties": false,
        "properties": {
          "segmentId": {
            "type": "string",
            "pattern": "^[a-z][a-z_]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 2
          },
          "releaseState": {
            "enum": [
              "presentation",
              "future"
            ]
          }
        }
      }
    },
    "customers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "customerId",
          "displayName",
          "segmentId",
          "preferenceTags",
          "personality",
          "releaseState",
          "assetKey",
          "dialogueSetId"
        ],
        "additionalProperties": false,
        "properties": {
          "customerId": {
            "type": "string",
            "pattern": "^guest\\.[a-z0-9.-]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 2
          },
          "segmentId": {
            "type": "string"
          },
          "preferenceTags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "personality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "energy",
              "curiosity",
              "sociability",
              "patienceStyle",
              "tasteAdventure"
            ],
            "properties": {
              "energy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "curiosity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "sociability": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "patienceStyle": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "tasteAdventure": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "releaseState": {
            "enum": [
              "alpha_scripted",
              "future"
            ]
          },
          "assetKey": {
            "type": "string"
          },
          "dialogueSetId": {
            "type": "string"
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "poolId",
          "version",
          "releaseState",
          "regionId",
          "modeIds",
          "fixedCustomers",
          "entries",
          "vipBaseBps",
          "vipCapBps",
          "featureGate"
        ],
        "properties": {
          "poolId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "releaseState": {
            "enum": [
              "alpha_scripted",
              "future"
            ]
          },
          "regionId": {
            "type": "string"
          },
          "modeIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fixedCustomers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "customerId",
                "weight"
              ],
              "properties": {
                "customerId": {
                  "type": "string"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            }
          },
          "vipBaseBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "vipCapBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "featureGate": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "satisfaction",
        "reputation",
        "loyalty"
      ],
      "properties": {
        "satisfaction": {
          "type": "object"
        },
        "reputation": {
          "type": "object"
        },
        "loyalty": {
          "type": "object"
        }
      }
    },
    "flagsDefault": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "const": false
      }
    },
    "alphaFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionId",
        "customerIds",
        "visibleOrderCount",
        "winOrderCount",
        "usesTrust",
        "usesPatience"
      ],
      "properties": {
        "missionId": {
          "const": "coconut-cove-001"
        },
        "customerIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "visibleOrderCount": {
          "const": 2
        },
        "winOrderCount": {
          "const": 2
        },
        "usesTrust": {
          "const": false
        },
        "usesPatience": {
          "const": false
        }
      }
    }
  }
}
