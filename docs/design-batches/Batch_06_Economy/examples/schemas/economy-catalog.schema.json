{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Economy Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "currency",
    "shops",
    "upgrades"
  ],
  "properties": {
    "schemaVersion": {
      "const": "economy-catalog.v1"
    },
    "status": {
      "enum": [
        "draft",
        "staged",
        "published"
      ]
    },
    "currency": {
      "const": "COINS"
    },
    "shops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "islandId",
          "archetype"
        ]
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "shopArchetype",
          "maxLevel",
          "levels",
          "requires",
          "cosmeticOnly",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "utility",
              "attraction",
              "cosmetic",
              "prestige",
              "expansion"
            ]
          },
          "maxLevel": {
            "type": "integer",
            "minimum": 1
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "level",
                "priceCoins",
                "effect"
              ],
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1
                },
                "priceCoins": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cosmeticOnly": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "draft",
              "staged",
              "published"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
