      "path": "/v1/friends/{userId}/block",
      "illustrativeResponse": "{} → blockRevision"
    },
    {
      "method": "POST",
      "path": "/v1/challenges",
      "illustrativeResponse": "{targetPlayerId,competitionId} → challengeId"
    },
    {
      "method": "POST",
      "path": "/v1/crews/{crewId}/projects/{projectId}/contribute",
      "illustrativeResponse": "{verifiedReceiptId} → contributionReceiptId"
    }
  ],
